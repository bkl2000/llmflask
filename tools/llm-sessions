#!/usr/bin/env bash
set -euo pipefail
# Manage chat sessions for one server-side user.
# Env: LLMFLASK_HOST, LLMFLASK_PORT, LLMFLASK_USER

show_help() {
  echo "Usage: llm-sessions [--host HOST] [--port PORT] [--user USER] ACTION [ARGS...]"
  echo "Actions: list, remove"
}

HOST="${LLMFLASK_HOST:-127.0.0.1}"
PORT="${LLMFLASK_PORT:-5000}"
USER_NAME="${LLMFLASK_USER:-default}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) show_help; exit 0 ;;
    --host|--port|--user)
      [[ $# -ge 2 ]] || { echo "llm-sessions: $1 requires a value" >&2; exit 2; }
      case "$1" in
        --host) HOST="$2" ;;
        --port) PORT="$2" ;;
        --user) USER_NAME="$2" ;;
      esac
      shift 2 ;;
    --*) echo "llm-sessions: unknown option '$1' before action" >&2; exit 2 ;;
    *) break ;;
  esac
done

[[ $# -gt 0 ]] || { show_help >&2; exit 2; }
case "$1" in
  list|remove) ;;
  *) echo "llm-sessions: unknown action '$1'" >&2; show_help >&2; exit 2 ;;
esac

exec llmflask --host "$HOST" --port "$PORT" --user "$USER_NAME" session "$@"
